# Optional. Only needed for `fetch` and `list`, on a Canvas that lets students create
# API tokens (UVG does not; use the bookmarklet and `import` there).
# Copy to ~/.config/preflight/.env, outside this repo and outside any folder you audit.
CANVAS_BASE_URL=https://uvg.instructure.com
CANVAS_TOKEN=
# Time zone for due dates in reports.
PREFLIGHT_TZ=America/Guatemala
